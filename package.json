{
  "name": "protocol-alpha-finder",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir ../dist-pages/frontend",
    "start": "python3 scripts/serve_research.py --port 4173",
    "test": "python3 -m unittest discover -s tests -p 'test_frontend_api.py'",
    "test:e2e": "playwright test",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
