flowchart TB
    subgraph HISTORY["历史证据"]
        direction LR
        E0["合约调用<br/>调用函数与执行顺序"]
        E1["交易回执与事件日志<br/>成功执行的操作与真实执行者"]
        E2["资产流动<br/>代币转移与执行费用"]
        E3["协议状态<br/>操作发生时的协议条件"]
    end
    subgraph WORKFLOW["研究流程"]
        direction LR
        N0["01 分析历史执行<br/>匹配已知 Seed 的操作<br/>还原调用过程与资产流动<br/>比较重复发生的执行记录"]
        N1["02 策略钱包<br/>识别真正执行操作的钱包<br/>保留 Seed 与对应交易证据<br/>研究原始 Seed 之外的行为"]
        N0 --> N1
        N2["03 观察新增活动<br/>读取新合约与新调用记录<br/>与钱包已有历史行为对比<br/>重新检查协议的当前条件"]
        N1 --> N2
        N3["04 Alpha 候选<br/>说明可能成立的收益机制<br/>附上执行记录与成本估计<br/>写出检验这一判断的方法"]
        N2 --> N3
    end
    HISTORY --> WORKFLOW
    V["检验交易证据、执行成本与当前协议条件"]
    N3 --> V
    R["每个候选都有一份报告"]
    A["验证支持后形成新的 Alpha"]
    V --> R
    V --> A
    A -. "已确认的机制 → 新的 Seed" .-> N0
    %% 观察指重复采集与复查钱包活动；当前工作流由手动启动这些检查。
