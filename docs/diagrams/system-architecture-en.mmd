flowchart LR
    SEED0["Energy Rental<br/>Clear depleted rental orders,<br/>recover resources and rewards."]
    SEED1["JustLend<br/>Repay undercollateralized loans<br/>and receive seized collateral."]
    SEED2["USDD<br/>Trigger liquidation, restart auctions,<br/>or purchase auction collateral."]
    WALLET0["Wallet A<br/>Rental liquidations"]
    WALLET1["Wallet B<br/>Resource bundling"]
    WALLET2["Wallet C<br/>Lending liquidations"]
    WALLET3["Wallet D<br/>Collateral redemption"]
    WALLET4["Wallet E<br/>Keeper actions"]
    WALLET5["Wallet F<br/>Auction purchases"]
    CANDIDATE0["Rental sequence<br/>Bundled calls may lower<br/>execution costs."]
    CANDIDATE1["Collateral recycling<br/>Redeem + swap may release<br/>capital sooner."]
    CANDIDATE2["Auction timing<br/>Temporary discounts may justify<br/>a closer look at execution costs."]
    SEED0 --> WALLET0
    WALLET0 --> CANDIDATE0
    SEED0 --> WALLET1
    WALLET1 --> CANDIDATE0
    CANDIDATE0 --> VALIDATION
    SEED1 --> WALLET2
    WALLET2 --> CANDIDATE1
    SEED1 --> WALLET3
    WALLET3 --> CANDIDATE1
    CANDIDATE1 --> VALIDATION
    SEED2 --> WALLET4
    WALLET4 --> CANDIDATE2
    SEED2 --> WALLET5
    WALLET5 --> CANDIDATE2
    CANDIDATE2 --> VALIDATION
    VALIDATION["04  Validation"]
    NEW["New Alpha<br/>Only if validation supports it"]
    REPORT["Alpha Report<br/>Evidence + next checks<br/>For every candidate"]
    VALIDATION --> NEW
    VALIDATION --> REPORT
    subgraph SKILLS["Skills"]
        S0["Skill 1 · Find wallets<br/>We identify wallets that executed seed mechanisms and verify their roles using transaction receipts.<br/>alpha-seed-wallets"]
        S1["Skill 2 · Investigate wallets<br/>We trace each wallet’s history to uncover repeated actions and propose new mechanisms.<br/>wallet-alpha-investigation"]
        S2["Skill 3 · Validate candidates<br/>We test each candidate against transaction evidence, execution costs, and current protocol conditions.<br/>protocol-alpha-validation"]
        S3["Skill 4 · Direct the research<br/>We coordinate the three research steps, preserve evidence, and select what to investigate next.<br/>protocol-alpha-discovery"]
    end
