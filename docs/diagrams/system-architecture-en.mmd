%% Colored Skill nodes annotate the transitions between research artifacts.
flowchart LR
    subgraph SEEDS["Alpha Seeds"]
        SEEDS0["Energy Rental<br/>Liquidate rental orders<br/>Resources + rewards"]
        SEEDS1["JustLend<br/>Liquidate unhealthy debt<br/>Receive collateral"]
        SEEDS2["USDD<br/>Trigger / reset / buy<br/>Keeper / auction actions"]
    end
    subgraph WALLETS["Strategy Wallets"]
        WALLETS0["Wallet A<br/>TNQ8…GDW2m<br/>Energy Rental liquidations<br/>Also rents and returns resources"]
        WALLETS1["Wallet B<br/>TUAA…uqrSS<br/>JustLend liquidations<br/>Also executes cross-pool swaps"]
        WALLETS2["Wallet C<br/>TFaz…hVFB<br/>JustLend liquidations<br/>Also redeems seized collateral"]
    end
    subgraph CANDIDATES["Candidate Mechanisms"]
        CANDIDATES0["Rent → Liquidate → Return<br/>Bundling rental and liquidation<br/>may lower execution costs.<br/>Evidence: ordered receipt events"]
        CANDIDATES1["Liquidate → Redeem → Swap<br/>Redeeming and swapping collateral<br/>may recycle capital in one transaction.<br/>Evidence: liquidation + asset flows"]
        CANDIDATES2["Cross-pool round trip<br/>Same-token round trips may capture<br/>price differences between pools.<br/>Evidence: decoded swaps + transfers"]
    end
    S0["protocol-alpha-discovery<br/>Set scope · Coordinate evidence handoffs · Decide next checks"]
    S1["alpha-seed-wallets<br/>Find & verify executors<br/>Calls · Receipts · Executor roles"]
    S2["wallet-alpha-investigation<br/>Investigate wallet history<br/>Sequences · Flows · Hypotheses"]
    S3["protocol-alpha-validation<br/>Validate each candidate<br/>Mechanism · State · Costs / risks"]
    ALPHA["New Alpha<br/>If the mechanism is established<br/>Record its execution conditions<br/>Consider it as a new seed"]
    REPORT["Alpha Report<br/>Mechanism + evidence<br/>Current state + next checks<br/>Actionable · Monitor<br/>Rejected · Insufficient Evidence"]
    SEEDS --> S1 --> WALLETS --> S2 --> CANDIDATES --> S3
    S3 --> ALPHA
    S3 --> REPORT
    S0 -.-> S1
    S0 -.-> S2
    S0 -.-> S3
