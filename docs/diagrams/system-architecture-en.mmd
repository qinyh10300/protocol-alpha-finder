%% Compact entity groups; colored Skills annotate the transitions.
%% SVG uses cubic S curves; edit its layout in render_architecture.py.
flowchart LR
    subgraph SEEDS["Alpha Seeds"]
        SEEDS0["Energy Rental<br/>Rental liquidation"]
        SEEDS1["JustLend<br/>Lending liquidation"]
        SEEDS2["USDD<br/>Keeper / auction"]
    end
    subgraph WALLETS["Strategy Wallets"]
        WALLETS0["Wallet A · Rental<br/>Rent → liquidate → return"]
        WALLETS1["Wallet B · Lending<br/>Liquidation + cross-pool swaps"]
        WALLETS2["Wallet C · Lending<br/>Liquidation + redemption"]
    end
    subgraph CANDIDATES["Alpha Candidates"]
        CANDIDATES0["Rental sequence<br/>Bundled calls may lower costs."]
        CANDIDATES1["Collateral recycling<br/>Redeem + swap may free capital."]
        CANDIDATES2["Cross-pool loop<br/>Price gaps may reward a round trip."]
    end
    S0["Coordinate the pipeline<br/>protocol-alpha-discovery"]
    S1["Find & verify<br/>alpha-seed-wallets"]
    S2["Investigate history<br/>wallet-alpha-investigation"]
    S3["Validate mechanism<br/>protocol-alpha-validation"]
    ALPHA["New Alpha<br/>If validated"]
    REPORT["Alpha Report<br/>Evidence + next checks"]
    SEEDS --> S1 --> WALLETS --> S2 --> CANDIDATES --> S3
    S3 --> ALPHA
    S3 --> REPORT
    S0 -.-> S1
    S0 -.-> S2
    S0 -.-> S3
    style S0 fill:#edf6f0,stroke:#bad8c6
    style S1 fill:#edf4ff,stroke:#b7cff5
    style S2 fill:#f4effc,stroke:#d3c2ee
    style S3 fill:#fff5e5,stroke:#ecd1a2
